<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AnniversaryWall</RootNamespace>
    <AssemblyName>anniversary-wall</AssemblyName>
    <!-- Don't publish the local-only fallback state folder. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);App_Data\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- wwwroot/** is published automatically by the Web SDK. -->
    <Content Update="wwwroot\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

</Project>
